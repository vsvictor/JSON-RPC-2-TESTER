GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=40400
GATEWAY_TLS_SERVER_NAME=localhost
GATEWAY_CA_FILE=/absolute/path/to/gateway-ca.pem
GATEWAY_CONNECT_TIMEOUT_MS=10000
GATEWAY_RETRY_DELAY_MS=500
GATEWAY_CONTROL_PORT=8500
GATEWAY_CONTROL_TIMEOUT_MS=5000
GATEWAY_PING_INTERVAL_MS=10000
GATEWAY_MISSED_PONGS=3
GATEWAY_RECOVERY_ATTEMPTS=3
GATEWAY_UP_RETURN_SEC=30
